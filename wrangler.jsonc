{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-command-center",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
